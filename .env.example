# ============================================================================
# EMADECO — variables d'environnement (copiez ce fichier en « .env » en local)
# NE JAMAIS committer de vraies valeurs. Sur Render, saisissez-les dans « Environment ».
# Aucune de ces variables n'est lue par le frontend : elles restent côté serveur.
# ============================================================================

# --- Application -------------------------------------------------------------
# « production » sur l'hébergeur
NODE_ENV=development
PORT=3000
# Secret de signature des sessions (32 caractères minimum). Générer : openssl rand -base64 48
SESSION_SECRET=

# --- Supabase (obligatoire en production) --------------------------------------
# Projet Supabase > Settings > API. La clé « service_role » donne tous les droits :
# elle ne doit JAMAIS apparaître dans le frontend, Git ou les journaux.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Pi Network ----------------------------------------------------------------
# testnet | mainnet (une application Pi distincte par réseau)
PI_NETWORK=testnet
PI_API_BASE=https://api.minepi.com/v2
# Pi.init({ sandbox: true }) pour le bac à sable Pi (laisser false pour l'app auto-hébergée vérifiée)
PI_SANDBOX=false
# Clé de validation de domaine affichée dans le Pi Developer Portal : servie sur /validation-key.txt
PI_VALIDATION_KEY=
# Clé API serveur Pi : NON utilisée aujourd'hui (aucun paiement). À renseigner seulement si
# des paiements sont ajoutés un jour, après conception et revue dédiées.
PI_API_KEY=

# En-têtes de sécurité helmet (CSP, COOP, CORP) : 1 = activés. Par défaut désactivés (ils faisaient échouer
# la connexion Pi sur une autre application ; voir README « Dépannage connexion Pi »).
STRICT_HEADERS=

# --- Administration -------------------------------------------------------------
# Noms d'utilisateur Pi (séparés par des virgules) promus administrateurs à leur connexion.
ADMIN_PI_USERNAMES=

# --- Démonstration (jamais active en production) ---------------------------------
# Par défaut « true » quand Supabase n'est pas configuré (base en mémoire, données fictives).
DEMO_MODE=

# Système d'éveil (Render gratuit) : actif automatiquement sur Render.
# KEEP_ALIVE=false pour le couper ; KEEP_ALIVE_URL pour forcer une adresse https.
KEEP_ALIVE=
KEEP_ALIVE_URL=
